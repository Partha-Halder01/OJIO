# Copy to .env.vps ON THE VPS; chmod 600. Never commit the filled file.
# Always invoke Compose with --env-file .env.vps -f compose.vps.yaml.
APP_NAME=OJIO
APP_ENV=production
APP_DEBUG=false
# Copy Railway's APP_KEY unchanged when importing its database.
APP_KEY=
# Private staging over SSH only. Set your real HTTPS URL before public launch.
APP_URL=http://127.0.0.1:8080
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
LOG_CHANNEL=stderr
LOG_LEVEL=warning
BCRYPT_ROUNDS=12

DB_CONNECTION=mysql
DB_URL=
DB_HOST=db
DB_PORT=3306
DB_DATABASE=ojio
DB_USERNAME=ojio
# Source version is verified before import; never silently downgrade MySQL.
# Railway reports 9.7.2; its matching official image was verified during preflight.
VPS_MYSQL_IMAGE=mysql:9.7.2
# Use a NEW strong VPS password, not Railway's database password.
DB_PASSWORD=
# MySQL root password lives separately in .vps-mysql-root-password (chmod 600).

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
# false only for private SSH staging; MUST be true when HTTPS goes public.
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# Keep OFF while testing the copied database to avoid duplicate notifications.
# Configure private credentials and enable only during controlled cutover.
FCM_ENABLED=false
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
FCM_QUEUE_CONNECTION=database
GOOGLE_CLIENT_ID=893178945153-tvaejgs71t83so9pj747kq03smp2q888.apps.googleusercontent.com

# Server-only payment secrets. Leave empty until configured privately.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
MAIL_MAILER=log
MAIL_FROM_NAME=OJIO
