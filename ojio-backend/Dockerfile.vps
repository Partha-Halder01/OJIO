FROM php:8.4-fpm-bookworm AS app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates git unzip libzip-dev libonig-dev \
    && docker-php-ext-install pdo_mysql mbstring zip bcmath pcntl opcache \
    && rm -rf /var/lib/apt/lists/*

COPY --from=composer:2 /usr/bin/composer /usr/local/bin/composer
WORKDIR /var/www/html
COPY . .

RUN mkdir -p storage/app/private storage/app/public storage/framework/cache/data \
        storage/framework/sessions storage/framework/views storage/logs bootstrap/cache \
    && composer install --no-dev --prefer-dist --optimize-autoloader --no-interaction --no-scripts \
    && composer check-platform-reqs --no-dev \
    && php artisan package:discover --no-interaction \
    && ln -s /var/www/html/storage/app/public public/storage \
    && chown -R www-data:www-data storage bootstrap/cache \
    && chmod -R 750 storage bootstrap/cache \
    && chmod 755 storage storage/app storage/app/public \
    && chmod 755 vps-entrypoint.sh

COPY php.vps.ini /usr/local/etc/php/conf.d/zz-ojio.ini
COPY php-fpm.vps.conf /usr/local/etc/php-fpm.d/zz-ojio.conf
USER www-data
ENTRYPOINT ["/var/www/html/vps-entrypoint.sh"]
CMD ["php-fpm", "-F"]

FROM nginx:stable-alpine AS web
COPY nginx.vps.conf /etc/nginx/conf.d/default.conf
COPY --from=app /var/www/html/public /var/www/html/public
